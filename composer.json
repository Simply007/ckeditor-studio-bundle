{
  "name": "simply007/ckeditor-studio-bundle",
  "description": "CKEditor as the rich text editor in Pimcore Studio: classic and inline editors, configurable toolbar, optional CKEditor AI and real-time collaboration. Community package, not affiliated with Pimcore GmbH.",
  "license": "GPL-2.0-or-later",
  "type": "pimcore-bundle",
  "keywords": [
    "pimcore",
    "pimcore-studio",
    "ckeditor",
    "wysiwyg",
    "rich-text-editor"
  ],
  "homepage": "https://github.com/Simply007/ckeditor-studio-bundle",
  "authors": [
    {
      "name": "Ondrej Chrastina",
      "homepage": "https://ondrej.chrastina.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Simply007/ckeditor-studio-bundle/issues",
    "source": "https://github.com/Simply007/ckeditor-studio-bundle"
  },
  "require": {
    "php": ">=8.3",
    "pimcore/pimcore": "^2026.1",
    "pimcore/studio-ui-bundle": "^2026.3"
  },
  "autoload": {
    "psr-4": {
      "Simply007\\CKEditorStudioBundle\\": "src/"
    }
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Simply007\\CKEditorStudioBundle\\CKEditorStudioBundle"
      ]
    }
  }
}
